[Unit]
Description=zhaoshu cron shuyuan (POST /api/shuyuan via loopback)
After=zhaoshu-web.service

[Service]
Type=oneshot
User=zsweb
Group=zsweb
EnvironmentFile=/etc/zhaoshu-web/env
ExecStart=/usr/local/lib/zhaoshu/cron-call.sh /api/shuyuan 330
TimeoutStartSec=420
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
