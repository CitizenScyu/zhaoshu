# stopbook1031：=1 时把详情页/目录页并入正文停止点（缺省/其他值 = 关）。末章「下一章」指回详情/目录页的站
#   （m.cuoceng 等）不再因详情页取空判 empty_content_page 而整本缺章；仅多章书生效。
#   只下载线 env。读取点: scripts/engine-download.mjs（contentStopBookPages）。
# DOWNLOAD_CONTENT_STOP_BOOK_PAGES=0
# breakeryield1031：=1 时任一阶段遇本机限速器熔断/日限（CircuitOpenError/DailyRequestBudgetError，请求没出网）
#   立即停抓、当前章不判失败，按 source_unavailable + retryCause host_breaker 收口：回退层不标候选失败，
#   配合 DOWNLOAD_HOST_WAIT=1 按 host 忙不计次排队 30m 后同源续传。关 = 熔断后余下章节瞬时全判 chapter_failed，
#   连败收口 missing_chapters、候选标失败换源从头抓。只下载线 env。读取点: scripts/engine-download.mjs（breakerYield）。
#   breakerguard1031：本轮一章没新抓到却已有章失败（熔断是本轮自己打开的，源多半坏了）时不让出，照关开关口径。
# DOWNLOAD_BREAKER_YIELD=0
# recheckyield1031：=1 时正文跑完后的收尾目录复核遇瞬时不可达、且已抓章 ≥ 一半 ⇒ retryCause recheck_unavailable：
#   回退层不标候选失败，任务层照常计次退避，下次同源续传（已抓章走缓存）。关 = 复核失败即候选标失败 48h 换源从头抓。
#   只下载线 env。读取点: scripts/engine-download.mjs（recheckYield）。
# DOWNLOAD_RECHECK_YIELD=0
# chapterresume1031：=1 时目录 hash 变了（连载追加等）也逐章续传——同源同书且同序号章 url、章名都不变才复用缓存
#   （照旧核 sha256）；目录前就失败的检查点保留续传判据。关 = 目录一变整本从头抓。
#   只下载线 env。读取点: scripts/engine-download.mjs（chapterResume）。
# DOWNLOAD_RESUME_BY_CHAPTER=0
# keepcache1031：=1 时缓存核 sha256 通过的章不再原样重写（省临时文件+fsync+rename，跨实例种入的硬链接得以保留）。
#   关 = 缓存章照旧重写一遍（内容同字节）。只下载线 env。读取点: scripts/engine-download.mjs（keepCached）。
# DOWNLOAD_RESUME_KEEP_CACHED=0
# resumeseed1031：=1 时开跑前从同级实例（<state>/inst-N/download/out 的兄弟）同任务键目录里 done 章最多且未持锁的
#   检查点种入本实例（manifest 拷贝 + 章文件硬链接），并清本任务键下残留 download.lock。关 = 只认本实例检查点，
#   任务重试落到别的实例就从头抓。只下载线 env。读取点: runtime-download/entry.ts → resume-seed.ts。
# DOWNLOAD_RESUME_PEERS=0
# previewearly1031：=1 时付费墙预览（done 章中位 < 500 字）在首轮逐章抓取中提前判 preview_truncated：目录 ≥ 50 章且短章已过半
#   （收尾闸门必判），或已 done ≥ 50 章全是短章。关 = 抓完全书才判（常先因少数空页判 missing_chapters）。读取点: scripts/engine-download.mjs。
# DOWNLOAD_PREVIEW_EARLY=0
# noticeskip1031：=1 时章名含请假/无更/断更/停更/休更/感言等强公告词、源站正文取空的章写占位文本按 done 收口；
#   关 = 该章 failed → 全书 missing_chapters 不发布。读取点: scripts/engine-download.mjs。
# DOWNLOAD_NOTICE_PLACEHOLDER=0
# chaperr1031：=1 时白名单外的逐章失败（error=chapter_failed）在 manifest 章节上另记 error_kind =「构造器名[:HTTP 状态][:枚举 code]」
#   （不含上游文本/URL），补抓成功即删；纯诊断字段，任何判据都不读。读取点: scripts/engine-download.mjs。
# DOWNLOAD_CHAPTER_ERROR_KIND=0
# noticeaside1031：=1 时「编号书」（目录 ≥20 章且 ≥90% 章名含「第 N 章/节/回」）里不带编号、也非番外/楔子/序/尾声类的章，
#   源站正文取空即写占位按 done 收口；关 = 该章 failed → 全书 missing_chapters 不发布。读取点: scripts/engine-download.mjs。
# DOWNLOAD_NOTICE_UNNUMBERED=0
# rulehint1031：=1 时 download_failed 且异常为 RuleEngineError 的 manifest 另记 failure_hint（规则求值失败的固定分类，
#   如 JSON_RULE_ON_HTML / JS_EXEC:SyntaxError，不含报错原文）；纯诊断字段。读取点: scripts/engine-download.mjs。
# DOWNLOAD_RULE_FAIL_HINT=0
# stalelock1031：跨实例种子遇到同级 download.lock 时，锁与 manifest 都超 1h 未动即视为崩溃遗留、照常取作种子源
#   （只读同级、不删同级的锁）。关 = 持锁同级一律跳过。需 DOWNLOAD_RESUME_PEERS 同开才生效。
#   1/true/on 开。只下载线 env。读取点: runtime-download/entry.ts（resumeStaleLocksEnabled）。
# DOWNLOAD_RESUME_STALE_LOCKS=0
# shutrel1030：停机（SIGTERM）时中止在途下载并原样放回 pending（不 +1、不退避、退还日预算；已拿到整本的照常发布）。
#   关 = 停机只停领新任务，在途任务被 systemd TimeoutStopSec 杀掉后要等回收器 30min+ 才重排。
#   只有恰好等于 '1' 才开。只下载线 env。读取点: runtime-download/entry.ts（releaseOnShutdown）。
# DOWNLOAD_SHUTDOWN_RELEASE=0
# hostwait1031：引擎回退的候选 host 全被别的任务占着（host_occupied，候选没真试过）时按排队放回：不计 attempt、
#   间隔 30m；不计数领取（lease_generation − attempt_count）达 32 次后回到计数路径，退避总量仍有界。
#   关 = 每次占用照常 attempt+1，同 host 长书在下时其余任务会被烧到 16 次落 partial。
#   只有恰好等于 '1' 才开。只下载线 env。读取点: runtime-download/entry.ts（hostWait）。
# DOWNLOAD_HOST_WAIT=0
# 共享限速后端四键（runtime 下载/预取服务共用的跨实例限速目录与控制文件；runtime-prefetch 模板
#   校验 lib/env.mjs 必须读齐这四键）。读取点: scripts/runtime-prefetch-template.mjs（与既有
#   runtime-download 服务侧同链路）。默认无——由 systemd 单元/服务装配注入。
# DOWNLOAD_SHARED_RATE_DIR=
# DOWNLOAD_RATE_CONTROL_FILE=
# DOWNLOAD_RATE_AUTHORITY_ID=
# DOWNLOAD_RATE_EXPECTED_EPOCH=
# 执行器目标私库全名 owner/repo（runtime-download 侧 requiredEnv 硬取，缺则启动即报缺）。
#   读取点: runtime-download/entry.ts:82/121（createDownloadExecutor / resolveRepositoryId）。默认无。
#   注意与 ZHAOSHU_BOOKS_REPO（Vercel 侧读私库内容用，有默认值）是两个不同链路的键。
# GITHUB_REPOSITORY=

# =============================================================================
# 平台/测试内置、不该写进本样例的键：CI / NODE_ENV / TEMP / TMP /
# JEST_WORKER_ID / HTTP_PROXY / HTTPS_PROXY / NO_PROXY /
# PLAYWRIGHT_BROWSERS_PATH / PLAYWRIGHT_MODULE / UNDICI_NO_WASM_SIMD /
# VOL_DEBUG / VERCEL_OIDC_TOKEN。这些要么由运行平台注入、要么只在本地手动
# 脚本/单测里读，写进部署样例反而误导。Vercel/Neon 集成还会自动注入一整组
# POSTGRES_* / PG* 键，同样不必手工填。
# 以下以键名注释占位供代码实读键完整性检查，不需要在部署时填写：
# NODE_ENV=
# PLAYWRIGHT_BROWSERS_PATH=
# PLAYWRIGHT_MODULE=
# TEMP=
# TMP=
# VOL_DEBUG=
# HTTP_PROXY=
# HTTPS_PROXY=
# =============================================================================

# 换源覆盖率基准（41-covbench）：本地手动跑的评测脚本 scripts/coverage-bench.mjs /
#   scripts/coverage-bench.run.test.ts 读取，**不进部署环境**。默认 skip（COVBENCH_RUN 非 '1'
#   即跳过），出网需 HTTP(S)_PROXY 指向本机代理。以下为注释占位，部署时无需填写。
# COVBENCH_RUN=1
# COVBENCH_SAMPLE=
# COVBENCH_LABEL=
# COVBENCH_CODE=
# COVBENCH_OUT=
# COVBENCH_FIXTURE=
# COVBENCH_DUMP=
# COVBENCH_PROXY=
# COVBENCH_GLOBAL=
# COVBENCH_PER_HOST=
# PROBE_BUDGET_MS=

# 数据库配额（Neon HTTP 402）长退避毫秒数（41-q402fix）：T8 下载 worker / 书源刷新运行器 / Vercel 实例共用；
# 缺省 1800000（30 分钟，写死在 src/lib/db-quota.ts），非法值回落缺省，夹到 [60000, 14400000]。
# DB_QUOTA_BACKOFF_MS=

# 数据库 HTTP 外呼的超时上限毫秒数（infrasyn-42 M1）：getSql 走 quotaAwareFetch 时，无调用方
# signal 的请求补 AbortSignal.timeout 兜底；缺省 60000，非法/≤0 回落缺省。已有 signal 的调用透传不合并。
# DB_FETCH_TIMEOUT_MS=

# 切仓决策装配开关（capacity991）：runtime-download entry 装配期读取；缺省关=不注入 rollover
# 决策缝，发布行为与引入前一致。置 1 后每次发布前经端口取候选仓证据（storage_repositories +
# repository_capacity_ledger 对账账目）做 stay/switch/blocked 决策，证据缺失即失败不降级。
# ZHAOSHU_ROLLOVER_ENABLED=0
