[Unit]
Description=zhaoshu cron reclaim (POST /api/download/reclaim via loopback)
After=zhaoshu-web.service

[Service]
Type=oneshot
User=zsweb
Group=zsweb
EnvironmentFile=/etc/zhaoshu-web/env
ExecStart=/usr/local/lib/zhaoshu/cron-call.sh /api/download/reclaim 60
TimeoutStartSec=420
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
