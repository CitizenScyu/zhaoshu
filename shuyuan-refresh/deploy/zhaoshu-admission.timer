[Unit]
Description=zhaoshu source admission probe every 1h (phoenix runner, admchurn42)

[Timer]
# 每小时一轮(00:17、01:17 … 23:17 UTC),与 deploy/phoenix/zhaoshu-admission.timer 逐字同频;
# 门禁 src/lib/vercel-cron.test.ts 同时解析两个 deploy 目录,灾备按任一副本重建频率一致。
OnCalendar=*-*-* 00/1:17:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
