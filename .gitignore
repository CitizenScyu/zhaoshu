# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# CI 与本地跑 CI 门禁命令时由 vitest --outputFile 生成的报告，不入库
/.vitest-report.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# local scrape/debug captures
/douban_page.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# 书源合集数据(由 scripts/update_shuyuan.py 生成,不入库)
/data/

# 本地脚本凭据与数据快照
.env.pull
scripts/backfill.env
labels.jsonl

# python
__pycache__/
*.pyc

# T8 运行包打包产物（esbuild bundle + tar，可重复生成）
runtime-download/build/
