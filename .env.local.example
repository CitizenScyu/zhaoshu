# 引擎兜底总开关。**只有 '1' 才开**（scripts/douban_list.py:577）。默认关（book15-only，行为逐字不变）。
# LABELER_ENGINE_FALLBACK=0
# 引擎 CLI（engine-fetch.mjs）绝对路径；FALLBACK 开时必需，缺则本轮降级 book15-only。
#   读取点: scripts/labeler.py:1288。默认无。
# LABELER_ENGINE_CLI=
# 引擎 CLI 的 node 可执行路径。读取点: scripts/labeler.py:1294。默认 'node'。
# LABELER_ENGINE_NODE=node
# 引擎取文字数上限（打标只需样本，不需要全书）。默认 80000：对抓取/预检门槛 10000 字留 8 倍余量，
#   对试读门 5 章留 4–8 倍章数余量，且 ≤ SEGMENT_CHARS(250000) ⇒ 每本 1 次模型调用（旧值 500000 会走两段）。
#   低于质量门下限 10000 会被夹到 10000（再低会把健康书按「字数不足」拒收）。
#   读取点: scripts/labeler.py resolve_engine_target_chars。设 500000 即回退旧行为。
# LABELER_ENGINE_TARGET_CHARS=80000
# 死源判定的跨轮侧车有效期（秒）。默认 21600（6 小时）：判死的 host 在有效期内下轮直接跳过（零请求），
#   过期自动重新尝试。设 0 关闭跨轮记忆（改前行为）。侧车文件 <数据目录>/labels-dead-hosts.json。
#   读取点: scripts/labeler.py resolve_dead_host_ttl。
# LABELER_DEAD_HOST_TTL_SEC=21600
# 引擎取文分布式采样开关（lblseg41）。**只有 '1' 才开**；默认关，关时引擎路径逐字不变（只读开头）。
#   开时按目录位置取四段：开头 / 约 40% / 约 70% / 约 90%，各占 LABELER_ENGINE_TARGET_CHARS 的
#   25% / 18.75% / 12.5% / 18.75%（8 万时 20k/15k/10k/15k），每段不可用（有效字数 < 目标 40% 或
#   章均 < 300 字）就换候选源补这一段；模型额外输出 labels.arc（后期落差，证据须能在原文找到），
#   记录 prompt_version=v2、顶层 sampling 记每段来源。只作用于引擎条目，book15 路径不变。
#   读取点: scripts/labeler.py resolve_segmented。
# LABELER_SEGMENTED=0
# 分布式采样每本取文墙钟上限（秒）。默认 240；到时即停，已取到的段照用，其余段标「未取到」。
#   读取点: scripts/labeler.py resolve_seg_time_budget。
# LABELER_SEG_TIME_BUDGET_S=240
# 被拒冷却（秒）。默认 86400（24 小时）：近该秒数内被拒过的书**不跳过，排到本轮待处理队尾**
#   （两组各自保持原相对顺序），避免重启后总从名单头磨同一批刚被拒的书（名单头部正是作者冲突
#   最密集的一批，每次重启约 40 分钟 0 产出）。时间未知的旧拒收行（无 rejected_at 字段）按
#   「很久以前」处理、不后移。设 0 关闭后移（队列顺序与改前逐项相同）。拒收记录自带
#   ISO UTC 的 rejected_at 字段（scripts/labeler.py write_rejection）。
#   读取点: scripts/labeler.py resolve_reject_cooldown。
# LABELER_REJECT_COOLDOWN_S=86400
# 本地测试 / 基准测试工具使用，生产不要设置。
# E4_BENCH=0
# PIPE_SHIM_SYNC_BYTES=0
# PYTHON=python
# SKIP_TYPES=0

# -----------------------------------------------------------------------------
# H. runtime-download 执行器（phoenix 侧 systemd；Vercel 不用）
# -----------------------------------------------------------------------------
# shell 目录。读取点: scripts/build-runtime-download.mjs:22。
# 默认值: ../zhaoshu-books/runtime。
# RUNTIME_SHELL_DIR=
# 心跳文件。读取点: scripts/shuyuan-refresh/entry.ts:21。默认值: 无（不写心跳）。
# HEARTBEAT_FILE=
# 状态文件。读取点: scripts/shuyuan-refresh/entry.ts:33。默认值: 无。
# STATUS_FILE=
# 看门狗毫秒。读取点: scripts/shuyuan-refresh/entry.ts:34。默认值: 无（不设看门狗）。
# WATCHDOG_MS=150000
# 出错时打印堆栈。读取点: scripts/shuyuan-refresh/entry.ts:91。默认值: 关。
# DEBUG_STACK=0
# 下载发布目标分支（与 storage_repositories 反查出的同一条 branch）。读取点:
#   runtime-download/entry.ts:73、scripts/register-storage-repository.mjs:57、
#   runtime-download/snapshot-gc-cli.ts:12。默认 'main'。
# DOWNLOAD_TARGET_BRANCH=main
# book15 不可达时 builtin 任务回退引擎源池的开关。**只有恰好等于 '0' 才关**（回到只退避等 book15）；
#   其余/缺失 = 开。读取点: runtime-download/entry.ts:98。
# DOWNLOAD_ENGINE_FALLBACK=1
# 扣额度前的书源身份预检开关。**只有恰好等于 '0' 才关**（回到「书源不可达只在下载中判出、事后退还预算」）；
#   其余/缺失 = 开。读取点: runtime-download/entry.ts:128。
# DOWNLOAD_IDENTITY_PRECHECK=1
# 共享限速后端四键（runtime 下载/预取服务共用的跨实例限速目录与控制文件；runtime-prefetch 模板
#   校验 lib/env.mjs 必须读齐这四键）。读取点: scripts/runtime-prefetch-template.mjs（与既有
#   runtime-download 服务侧同链路）。默认无——由 systemd 单元/服务装配注入。
# DOWNLOAD_SHARED_RATE_DIR=
# DOWNLOAD_RATE_CONTROL_FILE=
# DOWNLOAD_RATE_AUTHORITY_ID=
# DOWNLOAD_RATE_EXPECTED_EPOCH=
# 执行器目标私库全名 owner/repo（runtime-download 侧 requiredEnv 硬取，缺则启动即报缺）。
#   读取点: runtime-download/entry.ts:82/121（createDownloadExecutor / resolveRepositoryId）。默认无。
#   注意与 ZHAOSHU_BOOKS_REPO（Vercel 侧读私库内容用，有默认值）是两个不同链路的键。
# GITHUB_REPOSITORY=

# =============================================================================
# 平台/测试内置、不该写进本样例的键：CI / NODE_ENV / TEMP / TMP /
# JEST_WORKER_ID / HTTP_PROXY / HTTPS_PROXY / NO_PROXY /
# PLAYWRIGHT_BROWSERS_PATH / PLAYWRIGHT_MODULE / UNDICI_NO_WASM_SIMD /
# VOL_DEBUG / VERCEL_OIDC_TOKEN。这些要么由运行平台注入、要么只在本地手动
# 脚本/单测里读，写进部署样例反而误导。Vercel/Neon 集成还会自动注入一整组
# POSTGRES_* / PG* 键，同样不必手工填。
# 以下以键名注释占位供代码实读键完整性检查，不需要在部署时填写：
# NODE_ENV=
# PLAYWRIGHT_BROWSERS_PATH=
# PLAYWRIGHT_MODULE=
# TEMP=
# TMP=
# VOL_DEBUG=
# HTTP_PROXY=
# HTTPS_PROXY=
# =============================================================================

# 换源覆盖率基准（41-covbench）：本地手动跑的评测脚本 scripts/coverage-bench.mjs /
#   scripts/coverage-bench.run.test.ts 读取，**不进部署环境**。默认 skip（COVBENCH_RUN 非 '1'
#   即跳过），出网需 HTTP(S)_PROXY 指向本机代理。以下为注释占位，部署时无需填写。
# COVBENCH_RUN=1
# COVBENCH_SAMPLE=
# COVBENCH_LABEL=
# COVBENCH_CODE=
# COVBENCH_OUT=
# COVBENCH_FIXTURE=
# COVBENCH_DUMP=
# COVBENCH_PROXY=
# COVBENCH_GLOBAL=
# COVBENCH_PER_HOST=
# PROBE_BUDGET_MS=

# 数据库配额（Neon HTTP 402）长退避毫秒数（41-q402fix）：T8 下载 worker / 书源刷新运行器 / Vercel 实例共用；
# 缺省 1800000（30 分钟，写死在 src/lib/db-quota.ts），非法值回落缺省，夹到 [60000, 14400000]。
# DB_QUOTA_BACKOFF_MS=

# 数据库 HTTP 外呼的超时上限毫秒数（infrasyn-42 M1）：getSql 走 quotaAwareFetch 时，无调用方
# signal 的请求补 AbortSignal.timeout 兜底；缺省 60000，非法/≤0 回落缺省。已有 signal 的调用透传不合并。
# DB_FETCH_TIMEOUT_MS=

# 切仓决策装配开关（capacity991）：runtime-download entry 装配期读取；缺省关=不注入 rollover
# 决策缝，发布行为与引入前一致。置 1 后每次发布前经端口取候选仓证据（storage_repositories +
# repository_capacity_ledger 对账账目）做 stay/switch/blocked 决策，证据缺失即失败不降级。
# ZHAOSHU_ROLLOVER_ENABLED=0
