[Unit]
Description=zhaoshu cron drain (POST /api/profile/absorb/drain via loopback)
After=zhaoshu-web.service

[Service]
Type=oneshot
User=zsweb
Group=zsweb
EnvironmentFile=/etc/zhaoshu-web/env
ExecStart=/usr/local/lib/zhaoshu/cron-call.sh /api/profile/absorb/drain 330
TimeoutStartSec=420
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
