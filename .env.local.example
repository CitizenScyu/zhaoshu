# =============================================================================
# zhaoshu / novel-finder —— 环境变量样例（.env.local.example）
# 复制为 .env.local 后填值；本文件只写键名与默认值，绝不写真实凭据。
# 部署到 Vercel 时改为在 Project → Settings → Environment Variables 里逐键填。
#
# 分组依据是「谁在读、缺了会怎样」。默认值一栏的「代码值」均从源码读得。
# 凡标「无默认」者，代码里就是 undefined/空串语义，缺了直接 fail-closed。
# =============================================================================

# -----------------------------------------------------------------------------
# A. 必需（核心链路，缺任一则对应功能不可用）
# -----------------------------------------------------------------------------
# Neon Postgres 连接串（Vercel 集成或 https://neon.tech 免费档）
# 形如 postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# 读取点: src/lib/db.ts:11。缺失后果: getSql() 拿不到连接串，几乎所有 /api 500。
DATABASE_URL=

# 所有 /api 请求的 owner 口令；浏览器右上角输入同一个值。
# 读取点: src/lib/auth.ts:36/89/177、src/lib/personal-request.ts:89、
#         src/lib/verify-ticket.ts:56、src/app/api/auth/owner/route.ts:58。
# 缺失后果: requireApiOwner() 直接返回 503 OWNER_NOT_CONFIGURED
#           （src/lib/auth.ts:37-42）——owner 通道全线不可用。
APP_OWNER_TOKEN=

# LLM：走 NewAPI 的公网入口（流式请求，绕开 CF ~100s 无响应砍线）。
# 这个主机名 = **phoenix** 上那台 new-api-phx 的公网入口，不是打标机（local-server）本机那台
# new-api；两台不同实例、同 system_name。2026-10-23 一手核实（无凭据）：公网 GET /api/status
# 的 start_time=1792709062 与 phoenix `docker inspect --format '{{.State.StartedAt}}'
# new-api-phx`（2026-10-22T22:44:22Z）同秒，打标机本机那台是 1792640043（03:34:03Z）。
# web 侧跑在 Vercel、只能走公网入口，所以下面这个值对 web 是对的；打标侧要用本机 loopback
# （见下面 LLM_URL 与 scripts/labeler.py 的 LLM_URL 注释）。
# 读取点: src/lib/llm.ts:19。默认值: 空串。
# 缺失后果: fail-closed（src/lib/llm.ts:377-381），调用期显式报错，
#           找书/画像/反馈等所有依赖 LLM 的功能不可用。
LLM_BASE_URL=https://api.cloud.us.kg/v1

# LLM 端点（打标/脚本侧）——与上面 web 侧的 LLM_BASE_URL 是**两个键**，别混。
# 读取点: scripts/labeler.py 的 resolve_llm_url、scripts/gatekeeper.py 的 resolve_probe_endpoint、
#         scripts/backfill_quality.mjs 的 resolveLlmUrl。
# 默认值: http://127.0.0.1:13001/v1/chat/completions（= 打标机本机那台 new-api 的 loopback
#         入口；来龙去脉见 scripts/labeler.py 的 LLM_URL 注释）。
# 缺失后果: 回落上述内置默认，不 fail-closed。
# ⚠ 三处解析**只认 env 文件**，不读进程环境：systemd 的 Environment=/EnvironmentFile=、
#   shell 里 export LLM_URL=... 都不生效（打标机的 zhaoshu-labeler.service 本来也没有
#   EnvironmentFile）。要改端点就改 .env 文件。唯一读进程环境的例外是 LABELER_DATA_DIR
#   （它要在找到 .env 之前就知道去哪儿找）。
# ⚠ 这个键的值会带着 LLM_API_KEY 与抓来的书内容一起发出去，指向哪台实例要想清楚：本机
#   loopback = 打标机自己那台；api.cloud.us.kg = phoenix 那台 new-api-phx（另一台实例，
#   本机的 key 未必在那边有效）。
# ⚠ 改完这个键要重启 gatekeeper：它只在启动时解析一次端点与模型链，labeler 子进程则每次
#   启动自己重读 .env，两者只在配置不变时才一致。
# ⚠ labeler.py 与 gatekeeper.py 必须**同批**部署：门卫复用 labeler.resolve_llm_url，
#   只换 gatekeeper.py 会撞上旧 labeler.py 里没有这个函数——门卫会以退出码 4 fail-closed
#   并印「两文件必须同批部署」（不是一眼看不懂的 AttributeError 崩循环），但打标照样全停。
LLM_URL=

# 建议在 NewAPI 里为本应用单独建一个限额 token，不要复用管理员 key。
# 读取点: src/lib/llm.ts:20。默认值: 空串。缺失后果: 同 LLM_BASE_URL，调用期显式报错。
LLM_API_KEY=

# 模型名（运行时解析链第 3 级: 数据库当前覆盖 → 数据库默认 → 本环境变量 → 硬编码缺省）。
# 读取点: src/lib/app-settings.ts:54。缺省回落到数据库/硬编码默认（claude-opus-5-88）。
LLM_MODEL=claude-opus-5-88

# -----------------------------------------------------------------------------
# B. 账号模式（可选；默认关闭，开启需两项同时到位）
# -----------------------------------------------------------------------------
# 部署开关。**只有恰好等于字符串 true 才开**，其余/缺失一律关。
# 读取点: src/lib/auth.ts:26。默认值: 关（旧入口保持零数据库契约）。
AUTH_ACCOUNTS_ENABLED=false

# 新随机密钥，UTF-8 ≥32 字节，用于限速键 HMAC 与 owner 凭据代际标签。
# 读取点: src/lib/auth-session.ts:59-61。默认值: 无（<32 字节视为未配置返回 null）。
# 缺失后果: 账号模式开启时拿不到 secret，限速/凭据标签链路失效。
#   ⚠️ 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   ⚠️ 千万不要复用 APP_OWNER_TOKEN，也不要提交进仓库。
AUTH_SECURITY_SECRET=

# 浏览器写请求的显式可信 origin（CSRF 同源校验）。
# 读取点: src/lib/csrf.ts:18。默认值: 空——缺失时回落到「与请求 URL 同源」判定
#   （src/lib/csrf.ts:20-24）。自定义域名部署建议显式设成该域名，收紧判定面。
AUTH_TRUSTED_ORIGIN=

# -----------------------------------------------------------------------------
# C. Cron（Vercel cron 鉴权 / 本地定时器）
# -----------------------------------------------------------------------------
# Vercel 以 Bearer <CRON_SECRET> 调用 cron 端点。
# 读取点: src/app/api/shuyuan/route.ts:29、src/app/api/download/reclaim/route.ts:20、
#         src/app/api/profile/absorb/drain/route.ts:37。
# 默认值: 无。缺失后果: cronRequest() fail-closed 返回 false，
#           带 Bearer 的 cron 请求会被当成普通请求要求 owner 权限 → cron 永远跑不起来。
CRON_SECRET=

# -----------------------------------------------------------------------------
# D. 下载链路（私库 zhaoshu-books）
# -----------------------------------------------------------------------------
# GitHub token（读私库内容 + workflow_dispatch）。
# 读取点: src/lib/github.ts:14/22、src/lib/reader-server.ts:97、
#         src/app/api/download/[id]/file/route.ts:19。
# 默认值: 无。缺失后果: triggerDownloadWorkflow() 抛 'GITHUB_TOKEN is not configured'
#           （src/lib/github.ts:14-16）；下载 worker 与私库读文件链路不可用。
GITHUB_TOKEN=

# 私库全名。读取点: src/lib/github.ts:3、src/lib/reader-server.ts:97、
#   src/app/api/download/[id]/file/route.ts:19。默认值: 'CitizenScyu/zhaoshu-books'。
ZHAOSHU_BOOKS_REPO=CitizenScyu/zhaoshu-books

# 旧私库 workflow_dispatch 开关。**只有恰好等于 '1' 才开**
# （src/lib/github.ts:13、src/app/api/download/route.ts:191）。
# 默认值: 关。缺失后果: 无（保持关闭，仅 builtin 用户请求走新链路）。
LEGACY_DOWNLOAD_DISPATCH_ENABLED=0

# -----------------------------------------------------------------------------
# E. LLM 调优（可选；全部有代码默认值，不设即用默认）
# -----------------------------------------------------------------------------
# 单次调用总超时（需小于 Vercel 函数 maxDuration）。
# 读取点: src/lib/llm.ts:151。默认值: 280000。
# LLM_TOTAL_TIMEOUT_MS=280000
# 单次调用 max_tokens。上游推理模型的思维链与正文共享该预算，设太小会让思维链
# 吃光额度、正文为空。读取点: src/lib/llm.ts:160。默认值: 16000。
# LLM_MAX_TOKENS=16000
# 传输层降级的兜底模型。读取点: src/lib/llm.ts:176。默认值: 'claude-opus-5-88'。
# LLM_FALLBACK_MODEL=claude-opus-5-88
# 单次尝试上限（首字节 + 流内停滞）。读取点: src/lib/llm.ts:214。默认值: 45000。
# LLM_ATTEMPT_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# F. 引擎源池（放量开关；默认关闭 = 零回归 book15-only）
# 额外上游合集直链（srcfeed）。分号分隔；每项必须是「**裸 JSON 数组**直链」
# （yckceo 式 index 页 + jsonUrl 逻辑只归 SHUYUAN_INDEX_URL 的固定 yckceo 一条）。
# 缺省/空串 ⇒ 不拉任何额外 feed（零行为变化）。例（可选，**勿把真实生产链接写进仓库**）：
#   https://raw.githubusercontent.com/shidahuilang/shuyuan-bak/main/good.json
#   https://raw.githubusercontent.com/aoaostar/legado/master/sources/b778fe6b.json
# 失败单条跳过（日志只留 host/文件名，不带签名）；yckceo 本身仍判「拉不全则中止保留旧数据」。
# SHUYUAN_EXTRA_FEEDS=
# idxretry1031：书源刷新的 yckceo 索引页 / 合集 JSON 拉取失败（非中止、非超预算）隔 3s 重试一次。
#   读取点 src/lib/shuyuan.ts（shuyuanFetchRetry）。只认 '1'；默认关 ⇒ 一次瞬时失败即整轮 502、顺延到次日 cron。
#   只重试上游拉取，不重试源探测（连败计数口径不变）；半挂判据不变。
# SHUYUAN_FETCH_RETRY=0

# -----------------------------------------------------------------------------
# 全局 kill switch。**只有 '1'/'true'/'on'（忽略大小写）才开**
#   （src/lib/shuyuan.ts:150-151）。默认值: 关。缺失后果: 池 = builtin only。
# READING_ENGINE_SOURCES=0
# 池上限。读取点: src/lib/shuyuan.ts:159。默认值: 4（非法/≤0/缺失均回落 4）。
# READING_POOL_LIMIT=4
# 每轮 cron 准入批次的真实搜索名额。读取点: src/lib/rule-engine/admission.ts
#   （admissionMaxProbes）。默认值: 20（非法/≤0/缺失均回落 20）。上调前先核
#   shuyuan.ts REFRESH_BUDGET_MS 注释里的墙钟推演：20 源最坏 ≈ 264s < 295s
#   平台上限，25 源会顶破。
# ADMISSION_MAX_PROBES=20
# 独立准入轮开关（42-admbudget）。读取点: src/lib/shuyuan.ts（admissionOwnCronEnabled）。
#   **只有 '1'/'true'/'on'（忽略大小写）才开**，其余/缺失一律关。开时 cron `/api/shuyuan/admission`
#   （vercel.json 每日 14:00 UTC，与 02:00 刷新错开 12h）自带 240s 整份预算再跑一轮准入，刷新尾部的
#   准入保留；两处经 cron_health 行 admission_lease 租约（5 分钟）互斥。关时该路由鉴权后空转返回、
#   刷新尾部不查租约（=今天行为逐字不变）。ADMISSION_MAX_PROBES 两处各自按轮计。
# ADMISSION_OWN_CRON=0
# 准入租约 TTL（毫秒；admrunner42）。读取点: src/lib/shuyuan.ts（admissionLeaseTtlMs）。默认 300000
#   （5 分钟，Vercel 两处入口用默认即可）；phoenix runner 单元设 900000（≥ 其 WATCHDOG_MS）。非法/≤0/缺失回落默认。
#   须 ≥ 持有者的最长存活，否则另一入口会在本轮未完时抢占租约并发探测。
# ADMISSION_LEASE_TTL_MS=300000
# phoenix runner 写 phoenix_ok: 待确认前缀（admgate1026 回滚开关）。读取点: src/lib/shuyuan.ts
#   （admissionRunnerPhoenixOkPrefix）。**只有 '1'/'true'/'on'（忽略大小写）才开**；默认关 ⇒ runner 探 ok
#   直接写干净 ok 入池、并照常复核在池 ok 行（web 与确认轮都已在 phoenix 本机，二次确认只制造积压）。
#   开 = 回到 admrunner42/admchurn42 旧行为（ok 写 phoenix_ok: 前缀、runner 不碰在池 ok 行）。
# ADMISSION_RUNNER_PHOENIX_OK=0
# stnredir1030：书源刷新的池可达性探测放行同站跳转（apex↔www./m.，目标须过运行时 host 门）。读取点:
#   src/lib/shuyuan.ts（probeSameStationRedirect）。**只有 '1'/'true'/'on'（忽略大小写）才开**；默认关 ⇒
#   探测跳转仍只信 jsdelivr，同站 301 判「非受信主机」。合集 JSON 抓取不受此开关影响。
# PROBE_SAME_STATION_REDIRECT=0
# 池合成 + 在线阅读目录会话读缓存 TTL（毫秒；xfer41，省 Neon 传输额度）。读取点:
#   src/lib/read-cache-ttl.ts。默认值: 300000（5 分钟）；0 = 关闭；非法回落默认；上限 3600000。
#   其他实例看到禁用/启用/新准入最多晚一个 TTL；本实例写路径立即失效。
# SHUYUAN_READ_CACHE_TTL_MS=300000
# engine-fetch.mjs（phoenix 打标线 CLI）源池跨进程文件缓存 TTL（毫秒）与目录。读取点:
#   scripts/engine-pool-cache.mjs。TTL 默认 600000；0 = 关闭；上限 3600000。目录默认 os.tmpdir()；
#   文件名带连接串哈希（换库不串池），内容只有公开书源规则与 host。
# ENGINE_POOL_CACHE_TTL_MS=600000
# ENGINE_POOL_CACHE_DIR=
# 源池产物（41-poolimpl）：池合成的四份库读（host 门 / 探测快照 / builtin 行 / 引擎行）改读每日产物，失败回退库。
#   读取点: src/lib/pool-artifact.ts。开关默认关（只有 1/true/on 才开）；关时逐字回到库读。
#   来源二选一，PATH 优先：PATH=本地文件（phoenix labeler/download/refresh-runner；refresh-runner 写库成功后
#   也写这个文件），URL=https 地址（Vercel；带 If-None-Match，304 复用）。产物缺失/过期/损坏 ⇒ 回退库读 + console.warn。
#   过期阈值（小时）默认 36；非法/≤0 回落默认，上限 336。
# SHUYUAN_POOL_ARTIFACT=0
# SHUYUAN_POOL_ARTIFACT_PATH=
# SHUYUAN_POOL_ARTIFACT_URL=
# SHUYUAN_POOL_ARTIFACT_MAX_AGE_HOURS=36
# 永久禁用 host 名单，分号或逗号分隔（小写比较）。读取点: src/lib/source-policy.ts（parsePermanentDisableEnv）；
#   命中的 host 永不进池/放行，用于硬下线某源。
# SHUYUAN_PERMANENT_DISABLE=
# 下载池接受 phoenix_ok: 源（bpool-expand）。**只有 '1'/'true'/'on'（忽略大小写）才开**；默认关 ⇒
#   下载池 = 阅读池（逐字回改前）。读取点: src/lib/shuyuan.ts（downloadPoolIncludesPhoenixOk）。
#   开时下载腿（runtime-download/engine.ts loadEnginePool）走 getDownloadPoolEngineHosts/getDownloadEngineSources，
#   放开 phoenix_ok: 前缀行（phoenix runner 探 ok、Vercel 未确认）——B 线下载出站全走 phoenix，用 Vercel
#   可达性门控下载池是口径错配。阅读池（取书/阅读器/源池产物）**不受影响**，仍排除 phoenix_ok: 行。
# DOWNLOAD_POOL_INCLUDE_PHOENIX_OK=0

# 多源并行读开关与上限（默认关闭、默认上限由代码决定）。
# SOURCE_FANOUT_ENABLED=0
# SOURCE_FANOUT_LIMIT=24

# 下载池扩池开关（bpool-normalize）。读取点: src/lib/shuyuan.ts（downloadPoolIncludesPhoenixOk）。
#   **只有 '1'/'true'/'on'（忽略大小写）才开**，其余/缺失一律关。默认值: 关。
#   缺省关 = 下载池不含 phoenix_ok:（与阅读池同口径，逐字零行为变化）；开 = 下载腿额外纳入
#   phoenix_ok: 行/host（直读 DB，不走源池产物）。阅读池口径不受影响。
# DOWNLOAD_POOL_INCLUDE_PHOENIX_OK=0

# 找书重排接地（41-rerankgnd）：候选命中书库 labeled_books 时把打标标签压缩后喂给重排，并按画像硬雷点做确定性否决。
#   读取点: src/lib/library-grounding.ts（libraryGroundingEnabled）。默认开；只有 0/false/off 关闭（关闭后提示词与接入前逐字节一致）。
# RERANK_LIBRARY_GROUNDING=1

# 准入探测并发度。读取点: src/lib/rule-engine/admission.ts（admissionProbeConcurrency）。
#   默认 1（=历史逐源串行，零行为变更）；非法/≤0/缺失回落 1，合法值再夹上限 8。
# ADMISSION_PROBE_CONCURRENCY=1
# http 升级源每轮首探上限（41-srcfix 改法2 放量控制）。读取点: src/lib/rule-engine/admission.ts
#   （admissionUpgradedMaxProbes）。bookSourceUrl 为 http:// 的源升 https 后进候选池，其**首次**探测
#   每轮最多占这么多名额（在 ADMISSION_MAX_PROBES 之内，不另加名额）；测过一次后按普通复测节奏。
#   默认 10；0 = 暂停这批源的首探；非法/负数/缺失回落 10。
# ADMISSION_UPGRADED_MAX_PROBES=10
# || 组合语法开关。**只有 '1'/'true'/'on'（忽略大小写）才开**，其余/缺失一律关（=旧 parser）。
#   读取点: src/lib/rule-engine/syntax-flags.ts（engineSyntaxOrEnabled）。默认关。
# ENGINE_SYNTAX_OR=0
# 简单子集 XPath 开关（xpath1027）：on 时 //tag[@a='v']/text()、/@attr 等子集翻成 CSS，子集外照旧拒。
#   口径同 ENGINE_SYNTAX_OR（只认 1/true/on）。读取点: syntax-flags.ts（engineSyntaxXPathEnabled）。默认关。
#   web / runner / download-b 三处 env 须同开，否则跨进程 rules_hash 3:/1: 来回翻。
# ENGINE_SYNTAX_XPATH=0
# @put/@get 静态子集开关（vars1027）：on 时编译前剥 @put，ruleBookInfo.init 只含 @put 时同组整条 @get:{k} 内联成 put 规则；
#   跨阶段 @get（目录/正文读搜索页/详情页变量）照旧拒。口径同 ENGINE_SYNTAX_OR。读取点: syntax-flags.ts（engineSyntaxVarsEnabled）。默认关。
#   web / runner / download-b 三处 env 须同开，否则跨进程 rules_hash 5–8:/1–4: 来回翻。
# ENGINE_SYNTAX_VARS=0
# 规则 JS 沙箱开关（jsbox1027）：on 时白名单字段（搜索 name/author/bookUrl、详情 name/author/tocUrl、目录 chapterName/
#   chapterUrl/nextTocUrl、正文 content/nextContentUrl）的 <js>/@js: 段在 QuickJS-wasm 沙箱里执行（无网络/文件/定时器，
#   单次 250ms、16MB，只给纯计算 java.*）；带 jsLib 的源整源不开。口径同 ENGINE_SYNTAX_OR。读取点: syntax-flags.ts
#   （engineSyntaxJsEnabled）。默认关。web / runner / download-b 三处 env 须同开，否则跨进程 rules_hash 9–16:/1–8: 来回翻。
# ENGINE_SYNTAX_JS=0
# XPath 求值开关（xpatheval1027）：须 ENGINE_SYNTAX_XPATH 同开；on 时翻不成 CSS 的 legado XPath 段（`@XPath:` 前缀或 `/` 开头，
#   如 following-sibling::、contains(text(),…)、position()/last() 谓词、//text()、并集 |）按 JsoupXpath 语义自写求值器执行
