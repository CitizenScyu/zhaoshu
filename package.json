{
  "name": "novel-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --no-file-parallelism",
    "check": "npm run typecheck && npm run lint && npm run check:deploy && npm test && npm run build",
    "check:deploy": "node scripts/check-deploy-config.mjs",
    "test:contracts": "vite-node scripts/check-worker-contract.mjs",
    "w1:candidates": "node --experimental-strip-types scripts/w1-candidates.mjs",
    "migrate:auth": "node --experimental-strip-types scripts/migrate-user-auth.mjs",
    "test:auth-db": "node --experimental-strip-types scripts/test-auth-db.mjs",
    "bench:auth": "node scripts/bench-auth.mjs",
    "db:check": "node --experimental-strip-types scripts/check-schema.mjs",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mjs",
    "test:db": "node --experimental-strip-types scripts/test-db.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "cheerio": "^1.2.0",
    "entities": "8.1.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
