/.vitest-report.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# local scrape/debug captures
/douban_page.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# 书源合集数据(由 scripts/update_shuyuan.py 生成,不入库)
/data/

# 本地脚本凭据与数据快照
.env.pull
scripts/backfill.env
labels.jsonl
# 死源跨轮记忆侧车（labeler 运行时写在数据目录 = 默认脚本同目录；只含 host 名与时间戳）
labels-dead-hosts.json
scripts/labels-dead-hosts.json

# python
__pycache__/
# shuyuan-refresh:只提交脚本与部署模板;打包产物是本机构建物(phoenix 侧另有 sha 比对)。
shuyuan-refresh/dist/
*.pyc

# T8 运行包打包产物（esbuild bundle + tar，可重复生成）
runtime-download/build/
