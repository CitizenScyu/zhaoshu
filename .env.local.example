# =============================================================================
# zhaoshu / novel-finder —— 环境变量样例（.env.local.example）
# 复制为 .env.local 后填值；本文件只写键名与默认值，绝不写真实凭据。
# 部署到 Vercel 时改为在 Project → Settings → Environment Variables 里逐键填。
#
# 分组依据是「谁在读、缺了会怎样」。默认值一栏的「代码值」均从源码读得。
# 凡标「无默认」者，代码里就是 undefined/空串语义，缺了直接 fail-closed。
# =============================================================================

# -----------------------------------------------------------------------------
# A. 必需（核心链路，缺任一则对应功能不可用）
# -----------------------------------------------------------------------------
# Neon Postgres 连接串（Vercel 集成或 https://neon.tech 免费档）
# 形如 postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# 读取点: src/lib/db.ts:11。缺失后果: getSql() 拿不到连接串，几乎所有 /api 500。
DATABASE_URL=

# 所有 /api 请求的 owner 口令；浏览器右上角输入同一个值。
# 读取点: src/lib/auth.ts:36/89/177、src/lib/personal-request.ts:89、
#         src/lib/verify-ticket.ts:56、src/app/api/auth/owner/route.ts:58。
# 缺失后果: requireApiOwner() 直接返回 503 OWNER_NOT_CONFIGURED
#           （src/lib/auth.ts:37-42）——owner 通道全线不可用。
APP_OWNER_TOKEN=

# LLM：走 NewAPI 的 Cloudflare Tunnel 公网入口（流式请求，绕开 CF ~100s 无响应砍线）。
# 读取点: src/lib/llm.ts:19。默认值: 空串。
# 缺失后果: fail-closed（src/lib/llm.ts:377-381），调用期显式报错，
#           找书/画像/反馈等所有依赖 LLM 的功能不可用。
LLM_BASE_URL=https://api.cloud.us.kg/v1

# 建议在 NewAPI 里为本应用单独建一个限额 token，不要复用管理员 key。
# 读取点: src/lib/llm.ts:20。默认值: 空串。缺失后果: 同 LLM_BASE_URL，调用期显式报错。
LLM_API_KEY=

# 模型名（运行时解析链第 3 级: 数据库当前覆盖 → 数据库默认 → 本环境变量 → 硬编码缺省）。
# 读取点: src/lib/app-settings.ts:54。缺省回落到数据库/硬编码默认（claude-opus-5-88）。
LLM_MODEL=claude-opus-5-88

# -----------------------------------------------------------------------------
# B. 账号模式（可选；默认关闭，开启需两项同时到位）
# -----------------------------------------------------------------------------
# 部署开关。**只有恰好等于字符串 true 才开**，其余/缺失一律关。
# 读取点: src/lib/auth.ts:26。默认值: 关（旧入口保持零数据库契约）。
AUTH_ACCOUNTS_ENABLED=false

# 新随机密钥，UTF-8 ≥32 字节，用于限速键 HMAC 与 owner 凭据代际标签。
# 读取点: src/lib/auth-session.ts:59-61。默认值: 无（<32 字节视为未配置返回 null）。
# 缺失后果: 账号模式开启时拿不到 secret，限速/凭据标签链路失效。
#   ⚠️ 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   ⚠️ 千万不要复用 APP_OWNER_TOKEN，也不要提交进仓库。
AUTH_SECURITY_SECRET=

# 浏览器写请求的显式可信 origin（CSRF 同源校验）。
# 读取点: src/lib/csrf.ts:18。默认值: 空——缺失时回落到「与请求 URL 同源」判定
#   （src/lib/csrf.ts:20-24）。自定义域名部署建议显式设成该域名，收紧判定面。
AUTH_TRUSTED_ORIGIN=

# -----------------------------------------------------------------------------
# C. Cron（Vercel cron 鉴权 / 本地定时器）
# -----------------------------------------------------------------------------
# Vercel 以 Bearer <CRON_SECRET> 调用 cron 端点。
# 读取点: src/app/api/shuyuan/route.ts:29、src/app/api/download/reclaim/route.ts:20、
#         src/app/api/profile/absorb/drain/route.ts:37。
# 默认值: 无。缺失后果: cronRequest() fail-closed 返回 false，
#           带 Bearer 的 cron 请求会被当成普通请求要求 owner 权限 → cron 永远跑不起来。
CRON_SECRET=

# -----------------------------------------------------------------------------
# D. 下载链路（私库 zhaoshu-books）
# -----------------------------------------------------------------------------
# GitHub token（读私库内容 + workflow_dispatch）。
# 读取点: src/lib/github.ts:14/22、src/lib/reader-server.ts:97、
#         src/app/api/download/[id]/file/route.ts:19。
# 默认值: 无。缺失后果: triggerDownloadWorkflow() 抛 'GITHUB_TOKEN is not configured'
#           （src/lib/github.ts:14-16）；下载 worker 与私库读文件链路不可用。
GITHUB_TOKEN=

# 私库全名。读取点: src/lib/github.ts:3、src/lib/reader-server.ts:97、
#   src/app/api/download/[id]/file/route.ts:19。默认值: 'CitizenScyu/zhaoshu-books'。
ZHAOSHU_BOOKS_REPO=CitizenScyu/zhaoshu-books

# 旧私库 workflow_dispatch 开关。**只有恰好等于 '1' 才开**
# （src/lib/github.ts:13、src/app/api/download/route.ts:191）。
# 默认值: 关。缺失后果: 无（保持关闭，仅 builtin 用户请求走新链路）。
LEGACY_DOWNLOAD_DISPATCH_ENABLED=0

# -----------------------------------------------------------------------------
# E. LLM 调优（可选；全部有代码默认值，不设即用默认）
# -----------------------------------------------------------------------------
# 单次调用总超时（需小于 Vercel 函数 maxDuration）。
# 读取点: src/lib/llm.ts:151。默认值: 280000。
# LLM_TOTAL_TIMEOUT_MS=280000
# 单次调用 max_tokens。上游推理模型的思维链与正文共享该预算，设太小会让思维链
# 吃光额度、正文为空。读取点: src/lib/llm.ts:160。默认值: 16000。
# LLM_MAX_TOKENS=16000
# 传输层降级的兜底模型。读取点: src/lib/llm.ts:176。默认值: 'claude-opus-5-88'。
# LLM_FALLBACK_MODEL=claude-opus-5-88
# 单次尝试上限（首字节 + 流内停滞）。读取点: src/lib/llm.ts:214。默认值: 45000。
# LLM_ATTEMPT_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# F. 引擎源池（放量开关；默认关闭 = 零回归 book15-only）
# -----------------------------------------------------------------------------
# 全局 kill switch。**只有 '1'/'true'/'on'（忽略大小写）才开**
#   （src/lib/shuyuan.ts:150-151）。默认值: 关。缺失后果: 池 = builtin only。
# READING_ENGINE_SOURCES=0
# 池上限。读取点: src/lib/shuyuan.ts:159。默认值: 4（非法/≤0/缺失均回落 4）。
# READING_POOL_LIMIT=4
# 每轮 cron 准入批次的真实搜索名额。读取点: src/lib/rule-engine/admission.ts
#   （admissionMaxProbes）。默认值: 20（非法/≤0/缺失均回落 20）。上调前先核
#   shuyuan.ts REFRESH_BUDGET_MS 注释里的墙钟推演：20 源最坏 ≈ 264s < 295s
#   平台上限，25 源会顶破。
# ADMISSION_MAX_PROBES=20
# 池合成 + 在线阅读目录会话读缓存 TTL（毫秒；xfer41，省 Neon 传输额度）。读取点:
#   src/lib/read-cache-ttl.ts。默认值: 300000（5 分钟）；0 = 关闭；非法回落默认；上限 3600000。
#   其他实例看到禁用/启用/新准入最多晚一个 TTL；本实例写路径立即失效。
# SHUYUAN_READ_CACHE_TTL_MS=300000
# engine-fetch.mjs（phoenix 打标线 CLI）源池跨进程文件缓存 TTL（毫秒）与目录。读取点:
#   scripts/engine-pool-cache.mjs。TTL 默认 600000；0 = 关闭；上限 3600000。目录默认 os.tmpdir()；
#   文件名带连接串哈希（换库不串池），内容只有公开书源规则与 host。
# ENGINE_POOL_CACHE_TTL_MS=600000
# ENGINE_POOL_CACHE_DIR=

# 多源并行读开关与上限（默认关闭、默认上限由代码决定）。
# SOURCE_FANOUT_ENABLED=0
# SOURCE_FANOUT_LIMIT=24

# 准入探测并发度。读取点: src/lib/rule-engine/admission.ts（admissionProbeConcurrency）。
#   默认 1（=历史逐源串行，零行为变更）；非法/≤0/缺失回落 1，合法值再夹上限 8。
# ADMISSION_PROBE_CONCURRENCY=1
# || 组合语法开关。**只有 '1'/'true'/'on'（忽略大小写）才开**，其余/缺失一律关（=旧 parser）。
#   读取点: src/lib/rule-engine/syntax-flags.ts（engineSyntaxOrEnabled）。默认关。
# ENGINE_SYNTAX_OR=0
# 换源标定旋钮（41-M1.1）；全部有代码默认值，非法/≤0/缺失回落默认后再钳区间。
#   读取点均在 src/lib/source-reader.ts（tunedValue）。
# SOURCE_FAILOVER_SLICE_MS=12000          # 换源单候选切片基准，钳 [4000, 20000]
# SOURCE_FAILOVER_MAX_ATTEMPTS=3          # 换源昂贵名额，上限 7
# SOURCE_CURRENT_SLICE_MS=12000           # 当前源正文切片基准，上限 20000
# 按站节流分桶开关。**只有恰好等于 '0' 才回滚**为全局单槽（改动前语义）；其余/缺失 = 按站分桶。
#   读取点: src/lib/source-reader.ts（sourceThrottleKey / probeThrottleSlots）。
# SOURCE_THROTTLE_PER_HOST=1
# 单 host 可疑窗口毫秒。读取点: src/lib/source-host-health.ts（sourceHostSuspectMs）。
#   默认 600000，钳 [60000, 3600000]；空串/非数字/≤0 回落默认。
# SOURCE_HOST_SUSPECT_MS=600000
# 单源探测限流窗口，逗号分隔的 `次数/窗口秒`（如 180/600,720/86400）。**'0' 关闭限流**；
#   缺失或任一项非法则整体回落默认（不按半截配置放行）。读取点: src/lib/source-probe-rate-limit.ts。
# SOURCE_PROBE_RATE_LIMITS=

# -----------------------------------------------------------------------------
# G. 测试与干跑（本地 / CI 用；生产不需要）
# -----------------------------------------------------------------------------
# 真库用例专用连接串。**生产不要设。**
# 默认值: 无。缺失后果: 依赖它的脚本明确退出码 2（不是静默跳过）。
# TEST_DATABASE_URL=
# 唯一允许跳过 PGlite 真库用例的开关。**CI 与 pre-push 硬断言不许设**
#   （ci.yml、.githooks/pre-push）。默认值: 未设。
# NF_PGLITE_OPTIONAL=
# 干跑不写库开关（scripts/shuyuan-refresh/dry-run.ts:61）。默认值: 关。
# DRY_RUN_NO_DB=0
# w1 候选调研输出目录（src/lib/rule-engine/w1-candidates.test.ts）。默认值: 无。
# RULE_SURVEY_DIR=
# 下载策略版本号，决定「同书是否算两个事件」（src/lib/importer-enqueue.ts:50）。
# 默认值: 't5-backfill-v1'。⚠️ 只有规则/来源快照真的变了才换号。
# LABELER_DOWNLOAD_POLICY_VERSION=t5-backfill-v1
# Python 标签器可选数据目录；缺省沿用仓内默认路径。
# LABELER_DATA_DIR=
# 以下四个是 phoenix 打标机自带 .env（scripts/labeler.py load_env 读，非 Vercel 部署键）：
# 打标模型链（逗号列表，覆盖内置链）。读取点: scripts/labeler.py:173-174、
#   scripts/gatekeeper.py:62（门卫探测同一链）。缺省回落旧 LLM_MODEL 单值兜底 / 内置 MODELS 链。
# LLM_MODELS=
# 引擎兜底总开关。**只有 '1' 才开**（scripts/douban_list.py:577）。默认关（book15-only，行为逐字不变）。
# LABELER_ENGINE_FALLBACK=0
# 引擎 CLI（engine-fetch.mjs）绝对路径；FALLBACK 开时必需，缺则本轮降级 book15-only。
#   读取点: scripts/labeler.py:1288。默认无。
# LABELER_ENGINE_CLI=
# 引擎 CLI 的 node 可执行路径。读取点: scripts/labeler.py:1294。默认 'node'。
# LABELER_ENGINE_NODE=node
# 本地测试 / 基准测试工具使用，生产不要设置。
# E4_BENCH=0
# PIPE_SHIM_SYNC_BYTES=0
# PYTHON=python
# SKIP_TYPES=0

# -----------------------------------------------------------------------------
# H. runtime-download 执行器（phoenix 侧 systemd；Vercel 不用）
# -----------------------------------------------------------------------------
# shell 目录。读取点: scripts/build-runtime-download.mjs:22。
# 默认值: ../zhaoshu-books/runtime。
# RUNTIME_SHELL_DIR=
# 心跳文件。读取点: scripts/shuyuan-refresh/entry.ts:21。默认值: 无（不写心跳）。
# HEARTBEAT_FILE=
# 状态文件。读取点: scripts/shuyuan-refresh/entry.ts:33。默认值: 无。
# STATUS_FILE=
# 看门狗毫秒。读取点: scripts/shuyuan-refresh/entry.ts:34。默认值: 无（不设看门狗）。
# WATCHDOG_MS=150000
# 出错时打印堆栈。读取点: scripts/shuyuan-refresh/entry.ts:91。默认值: 关。
# DEBUG_STACK=0
# 下载发布目标分支（与 storage_repositories 反查出的同一条 branch）。读取点:
#   runtime-download/entry.ts:73、scripts/register-storage-repository.mjs:57、
#   runtime-download/snapshot-gc-cli.ts:12。默认 'main'。
# DOWNLOAD_TARGET_BRANCH=main
# book15 不可达时 builtin 任务回退引擎源池的开关。**只有恰好等于 '0' 才关**（回到只退避等 book15）；
#   其余/缺失 = 开。读取点: runtime-download/entry.ts:98。
# DOWNLOAD_ENGINE_FALLBACK=1
# 扣额度前的书源身份预检开关。**只有恰好等于 '0' 才关**（回到「书源不可达只在下载中判出、事后退还预算」）；
#   其余/缺失 = 开。读取点: runtime-download/entry.ts:128。
# DOWNLOAD_IDENTITY_PRECHECK=1
# 执行器目标私库全名 owner/repo（runtime-download 侧 requiredEnv 硬取，缺则启动即报缺）。
#   读取点: runtime-download/entry.ts:82/121（createDownloadExecutor / resolveRepositoryId）。默认无。
#   注意与 ZHAOSHU_BOOKS_REPO（Vercel 侧读私库内容用，有默认值）是两个不同链路的键。
# GITHUB_REPOSITORY=

# =============================================================================
# 平台/测试内置、不该写进本样例的键：CI / NODE_ENV / TEMP / TMP /
# JEST_WORKER_ID / HTTP_PROXY / HTTPS_PROXY / NO_PROXY /
# PLAYWRIGHT_BROWSERS_PATH / PLAYWRIGHT_MODULE / UNDICI_NO_WASM_SIMD /
# VOL_DEBUG / VERCEL_OIDC_TOKEN。这些要么由运行平台注入、要么只在本地手动
# 脚本/单测里读，写进部署样例反而误导。Vercel/Neon 集成还会自动注入一整组
# POSTGRES_* / PG* 键，同样不必手工填。
# 以下以键名注释占位供代码实读键完整性检查，不需要在部署时填写：
# NODE_ENV=
# PLAYWRIGHT_BROWSERS_PATH=
# PLAYWRIGHT_MODULE=
# TEMP=
# TMP=
# VOL_DEBUG=
# =============================================================================

# 数据库配额（Neon HTTP 402）长退避毫秒数（41-q402fix）：T8 下载 worker / 书源刷新运行器 / Vercel 实例共用；
# 缺省 1800000（30 分钟，写死在 src/lib/db-quota.ts），非法值回落缺省，夹到 [60000, 14400000]。
# DB_QUOTA_BACKOFF_MS=
